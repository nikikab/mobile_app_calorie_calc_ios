{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to photograph food and scan barcodes."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Камерата се използва за снимане на храна и сканиране на баркодове."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird zum Fotografieren von Essen und Scannen von Barcodes verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para fotografiar comida y escanear códigos de barras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo sert à photographier les aliments et à scanner les codes-barres."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you turn on the activity option, KaloCalc reads only the active calories burned for a day, on your phone, to adjust that day's calorie target. Nothing is sent anywhere."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако включиш опцията за активност, KaloCalc чете само изгорените активни калории за деня, на телефона ти, за да коригира дневната цел. Нищо не се изпраща никъде."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Aktivitätsoption einschaltest, liest KaloCalc nur die verbrannten aktiven Kalorien eines Tages auf deinem Telefon, um das Kalorienziel dieses Tages anzupassen. Nichts wird irgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activas la opción de actividad, KaloCalc lee solo las calorías activas quemadas de un día, en tu teléfono, para ajustar el objetivo de calorías de ese día. No se envía nada a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu actives l'option d'activité, KaloCalc lit uniquement les calories actives brûlées dans une journée, sur ton téléphone, pour ajuster l'objectif calorique de ce jour. Rien n'est envoyé nulle part."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc writes the food you log (calories, protein, carbs and fat) to Apple Health, only if you turn this on."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc записва храната, която въвеждаш (калории, протеини, въглехидрати и мазнини), в Apple Health, само ако включиш това."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc schreibt das Essen, das du einträgst (Kalorien, Eiweiß, Kohlenhydrate und Fett), in Apple Health, nur wenn du das einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc escribe la comida que registras (calorías, proteínas, carbohidratos y grasas) en Apple Salud, solo si lo activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc écrit les aliments que tu enregistres (calories, protéines, glucides et lipides) dans Apple Santé, seulement si tu l'actives."
          }
        }
      }
    }
  }
}
