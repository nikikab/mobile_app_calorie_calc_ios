          }
        }
      }
    },
    "settings_gemini_intro": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С ключ приложението изпраща снимката към Gemini и получава приблизителна оценка на храната, грамажа и калориите. Без ключ работи само офлайн разпознаването на устройството."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Schlüssel sendet die App das Foto an Gemini und erhält eine ungefähre Schätzung von Essen, Portion und Kalorien. Ohne Schlüssel funktioniert nur die Erkennung auf dem Gerät, auch offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a key, the app sends the photo to Gemini and gets an approximate estimate of the food, portion and calories. Without a key, only the on-device recognition works offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una clave, la aplicación envía la foto a Gemini y recibe una estimación aproximada de la comida, la ración y las calorías. Sin clave, solo funciona el reconocimiento en el dispositivo, incluso sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une clé, l'application envoie la photo à Gemini et obtient une estimation approximative de l'aliment, de la portion et des calories. Sans clé, seule la reconnaissance sur l'appareil fonctionne, même hors connexion."
          }
        }
      }
    },
    "settings_get_key": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
