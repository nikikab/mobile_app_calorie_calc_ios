    "hc_activity_denied": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешението не беше дадено, затова целта си остава. Можеш да го разрешиш в Health Connect → Приложения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung wurde nicht erteilt, das Ziel bleibt unverändert. Du kannst sie in Health Connect → Apps erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission wasn't granted, so the target stays as it is. You can allow it in Health Connect → Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se concedió el permiso, así que el objetivo no cambia. Puedes permitirlo en Health Connect → Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation n'a pas été accordée, l'objectif reste inchangé. Vous pouvez l'autoriser dans Health Connect → Applications."
          }
        }
      }
    },
    "hc_activity_hint": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чете активните изгорени калории от Health Connect. Ако даден ден се различава много от активността, която нормата ти вече предполага, към целта се добавя или маха само частта извън допустимото ±25% (никога под калориите ти в покой; за днес само нагоре)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die aktiv verbrannten Kalorien aus Health Connect. Weicht ein Tag stark von der Aktivität ab, die dein Bedarf schon annimmt, wird nur der Teil außerhalb eines ±25-%-Puffers zum Ziel addiert oder abgezogen (nie unter deinen Grundbedarf; heute nur nach oben)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads active calories burned from Health Connect. If a day differs a lot from the activity your norm already assumes, only the part beyond a ±25% margin is added to or taken off the target (never below your resting needs; today it only goes up)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las calorías activas quemadas de Health Connect. Si un día difiere mucho de la actividad que ya supone tu norma, solo la parte que supera un margen de ±25 % se suma al objetivo o se resta (nunca por debajo de tus necesidades en reposo; hoy solo al alza)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les calories actives brûlées dans Health Connect. Si une journée s'écarte beaucoup de l'activité déjà prévue par votre norme, seule la part au-delà d'une marge de ±25 % est ajoutée à l'objectif ou retirée (jamais sous vos besoins au repos ; aujourd'hui, uniquement à la hausse)."
          }
        }
      }
    },
    "hc_activity_switch": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коригирай целта според изгорените калории"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel nach verbrannten Kalorien anpassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust target by burned calories"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
