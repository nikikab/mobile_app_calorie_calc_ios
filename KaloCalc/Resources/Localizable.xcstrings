    "import_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущите записи, тегло, профил и снимки ще бъдат ЗАМЕНЕНИ с тези от файла. Това не може да се върне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Einträge, das Gewicht, das Profil und die Fotos werden durch die aus der Datei ERSETZT. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current entries, weight, profile and photos will be REPLACED with those from the file. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros, el peso, el perfil y las fotos actuales serán REEMPLAZADOS por los del archivo. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées, le poids, le profil et les photos actuels seront REMPLACÉS par ceux du fichier. Cette action est irréversible."
          }
        }
      }
    },
