    "hc_intro": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Записва храната, която добавяш (калории, протеини, въглехидрати, мазнини и хранене), в Health Connect, за да я виждат другите ти приложения за здраве. KaloCalc не изпраща нищо извън телефона ти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt das Essen, das du einträgst (Kalorien, Eiweiß, Kohlenhydrate, Fett und Mahlzeit), in Health Connect, damit deine anderen Gesundheits-Apps es sehen können. KaloCalc sendet nichts von deinem Handy weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes the food you log (calories, protein, carbs, fat and meal) to Health Connect, so your other health apps can see it. KaloCalc sends nothing off your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en Health Connect la comida que registras (calorías, proteínas, carbohidratos, grasas y comida), para que tus otras apps de salud la vean. KaloCalc no envía nada fuera de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit les aliments que vous saisissez (calories, protéines, glucides, lipides et repas) dans Health Connect, pour que vos autres applications de santé les voient. KaloCalc n'envoie rien hors de votre téléphone."
          }
        }
      }
    },
    "hc_not_installed": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирай или включи Health Connect, за да ползваш това."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere oder aktiviere Health Connect, um dies zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install or enable Health Connect to use this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o activa Health Connect para usar esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez ou activez Health Connect pour utiliser cette fonction."
          }
        }
      }
    },
    "hc_rationale_body": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc записва в Health Connect това, което добавяш в дневника (име, хранене, калории, протеини, въглехидрати и мазнини), и то само след твое разрешение. Ако включиш и опцията за активност, чете само активните изгорени калории за деня, на телефона ти, за да коригира целта за този ден. Не чете други здравни данни и не изпраща нищо към нас. Можеш да изключиш което и да е от двете в Настройки на KaloCalc или да премахнеш разрешенията в Health Connect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc schreibt das, was du im Tagebuch einträgst (Name, Mahlzeit, Kalorien, Eiweiß, Kohlenhydrate und Fett), in Health Connect, und nur nach deiner Erlaubnis. Wenn du auch die Aktivitätsoption einschaltest, liest die App nur die aktiv verbrannten Kalorien eines Tages, auf deinem Handy, um das Tagesziel anzupassen. Sie liest keine anderen Gesundheitsdaten und sendet nichts an uns. Du kannst beides in den KaloCalc-Einstellungen ausschalten oder die Berechtigungen in Health Connect entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc writes what you log in the diary (name, meal, calories, protein, carbs and fat) to Health Connect, and only after you allow it. If you also turn on the activity option, it reads only the active calories burned for a day, on your phone, to adjust that day's target. It reads no other health data and sends nothing to us. You can turn either off in KaloCalc Settings or remove the permissions in Health Connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc escribe en Health Connect lo que registras en el diario (nombre, comida, calorías, proteínas, carbohidratos y grasas), y solo después de que lo permitas. Si activas también la opción de actividad, lee únicamente las calorías activas quemadas de un día, en tu teléfono, para ajustar el objetivo de ese día. No lee otros datos de salud y no nos envía nada. Puedes desactivar cualquiera de las dos en Ajustes de KaloCalc o quitar los permisos en Health Connect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KaloCalc écrit dans Health Connect ce que vous saisissez dans le journal (nom, repas, calories, protéines, glucides et lipides), et seulement après votre autorisation. Si vous activez aussi l'option d'activité, elle lit uniquement les calories actives brûlées d'une journée, sur votre téléphone, pour ajuster l'objectif de ce jour. Elle ne lit aucune autre donnée de santé et ne nous envoie rien. Vous pouvez désactiver l'un ou l'autre dans les Réglages de KaloCalc ou retirer les autorisations dans Health Connect."
          }
        }
      }
    },
    "hc_rationale_title": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
