          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster l'objectif selon les calories brûlées"
          }
        }
      }
    },
    "hc_denied": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешението не е дадено, затова синхронизацията остава изключена. Можеш да го дадеш в Health Connect → Приложения."
          }
        },
        "de": {
          "stringUnit": {
