    "calc_medical_note": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е общ ориентир, не медицински съвет. Инсулиновата резистентност трябва да се диагностицира и води от лекар, който може да предложи други цели."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine allgemeine Richtlinie, keine medizinische Beratung. Eine Insulinresistenz sollte von einem Arzt diagnostiziert und betreut werden, der andere Ziele vorschlagen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a general guideline, not medical advice. Insulin resistance should be diagnosed and managed by a doctor, who may suggest other targets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una pauta general, no consejo médico. La resistencia a la insulina debe ser diagnosticada y tratada por un médico, que puede proponer otros objetivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est une indication générale, pas un avis médical. L'insulinorésistance doit être diagnostiquée et suivie par un médecin, qui peut proposer d'autres objectifs."
          }
        }
      }
    },
