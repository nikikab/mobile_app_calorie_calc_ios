    "settings_backup_intro": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Записва дневника, теглото, профила и снимките в един файл (ZIP), за да не ги загубиш при преинсталиране или смяна на телефона. Gemini ключът не се включва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert Tagebuch, Gewicht, Profil und Fotos in einer Datei (ZIP), damit nichts verloren geht, wenn du die App neu installierst oder das Handy wechselst. Der Gemini-Schlüssel ist nicht enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the diary, weight, profile and photos into one file (ZIP), so you don't lose them when you reinstall or change phones. The Gemini key is not included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el diario, el peso, el perfil y las fotos en un solo archivo (ZIP) para que no los pierdas al reinstalar la aplicación o cambiar de teléfono. La clave de Gemini no se incluye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le journal, le poids, le profil et les photos dans un seul fichier (ZIP), pour ne rien perdre si vous réinstallez l'application ou changez de téléphone. La clé Gemini n'est pas incluse."
          }
        }
      }
    },
